# CampusChop - Environment Configuration
# Copy this file to .env and fill in your actual Supabase credentials

# Supabase Public Configuration (Exposed to the browser via Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Paystack Public Key (for frontend popup or redirect initialization)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: NEVER put Supabase Service Role Key or Paystack Secret Key in this file.
# Secret keys belong ONLY in Supabase Edge Functions environment variables:
# supabase secrets set PAYSTACK_SECRET_KEY=sk_test_...
